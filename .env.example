# Copy to .env and fill in. Never commit .env.

# PayPal sandbox app (developer.paypal.com → Apps & Credentials → Sandbox)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Set after creating the webhook in the dashboard (needed for signature verification)
PAYPAL_WEBHOOK_ID=

# Sandbox personal account that plays the freelancer (receives payouts)
SPIKE_FREELANCER_EMAIL=

# AI
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# GitHub (read-only token for fetching PR evidence)
GITHUB_TOKEN=

# Database
DATABASE_URL=postgres://proofpay:proofpay@localhost:5432/proofpay

# Public base URL (PayPal return/cancel URLs)
APP_BASE_URL=http://localhost:3000
