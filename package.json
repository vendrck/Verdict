{
  "name": "proofpay",
  "version": "0.1.0",
  "private": true,
  "description": "AI-verified escrow with a dispute copilot, built on PayPal",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "spike:escrow": "tsx --env-file=.env scripts/spikes/escrow-flow.ts",
    "spike:inspect": "tsx --env-file=.env scripts/spikes/inspect.ts",
    "spike:verify": "tsx --env-file=.env scripts/spikes/verify-pr.ts",
    "spike:token": "tsx --env-file=.env scripts/spikes/check-credentials.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.90",
    "@ai-sdk/google": "4.0.98",
    "@ai-sdk/mcp": "^2.0.86",
    "@octokit/rest": "^22.0.1",
    "@paypal/mcp": "^1.8.1",
    "ai": "^7.0.155",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.3",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
